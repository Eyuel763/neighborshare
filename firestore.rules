rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users can update their own profile, but cannot tamper with security attributes
      allow write: if isOwner(userId) || hasRole('SystemAdmin');
    }

    // --- Listings Collection ---
    match /listings/{listingId} {
      allow read: if isAuthenticated();
      // Neighbors can create and edit listings; Moderators can edit/flag/moderate
      allow create: if hasRole('Neighbor') || hasRole('SubcityModerator') || hasRole('SystemAdmin');
      allow update, delete: if isOwner(resource.data.userId) || hasRole('SubcityModerator') || hasRole('SystemAdmin');
    }

    // --- Role Change Requests (Separation of Duties) ---
    match /role_requests/{requestId} {
      // Standard users can submit a request
      allow create: if isAuthenticated() && request.resource.data.requesterUid == request.auth.uid;
      // Requesters can view their own requests; Admins can view all
      allow read: if isAuthenticated() && (resource.data.requesterUid == request.auth.uid || hasRole('SystemAdmin'));
      // Only System Administrators can review/update (cannot approve their own request)
      allow update: if hasRole('SystemAdmin') && resource.data.requesterUid != request.auth.uid;
      allow delete: if hasRole('SystemAdmin');
    }

    // --- Audit Logs (Restricted Access) ---
    match /audit_logs/{logId} {
      allow read: if hasRole('SecurityAuditor') || hasRole('SystemAdmin');
      // Immutable from client SDK: logs can only be created via server/Cloud Functions
      allow write: if false;
    }
  }
}